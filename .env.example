# Copy to .env and fill real values. NEVER commit .env.

# --- App ---
PROJECT_NAME=Intern Portal API
API_V1_PREFIX=/api/v1
# Comma-separated allowed origins for CORS, or * for all (dev only)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (SQLAlchemy URL, psycopg3 driver) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intern_portal

# --- JWT / Security ---
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloud storage (bucket) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For local dev, an absolute base makes content_url usable from the frontend:
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
MAX_UPLOAD_MB=25
# When STORAGE_BACKEND=s3 (S3-compatible / GCS):
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL_BASE=
