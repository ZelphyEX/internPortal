# Copy to .env and fill real values. NEVER commit .env.

# --- App ---
PROJECT_NAME=Intern Portal API
API_V1_PREFIX=/api/v1
# Comma-separated allowed origins for CORS, or * for all (dev only)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (SQLAlchemy URL, psycopg3 driver) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intern_portal

# --- JWT / Security ---
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Đăng nhập bằng Google (BẮT BUỘC: đây là cách duy nhất để người dùng vào) ---
# OAuth 2.0 Client ID (loại "Web application") của GCP project. Thiếu biến này thì
# POST /auth/google trả 503 và không ai đăng nhập được.
GOOGLE_CLIENT_ID=
# Consent Screen đang là "External" nên Google KHÔNG tự chặn tên miền — backend chặn.
# Chỉ email thuộc các tên miền này mới đăng ký/đăng nhập được:
ALLOWED_EMAIL_DOMAINS=gimasys.com,edu.gimasys.com
# Ai đăng nhập lần đầu cũng là INTERN và dùng được ngay — tên miền KHÔNG quyết định
# vai trò. Muốn lên MENTOR thì gửi yêu cầu chuyển vai trò để ADMIN duyệt.
# Vé đăng ký tạm (phút) — thời gian người dùng có để điền hồ sơ sau khi Google xác thực.
SIGNUP_TICKET_EXPIRE_MINUTES=30
# CHỈ dùng khi dev không có GOOGLE_CLIENT_ID. ĐỪNG bật ở môi trường thật:
# bật lên là ai cũng tự tạo credential giả để đăng nhập bằng email bất kỳ.
ALLOW_MOCK_GOOGLE_LOGIN=false

# --- Tài khoản Quản trị viên hệ thống ---
# scripts/ensure_admin.py chạy mỗi lần container khởi động và đồng bộ tài khoản này.
# Đây là tài khoản DUY NHẤT đăng nhập được bằng mật khẩu (mọi role khác phải qua Google).
# Email phải thuộc ALLOWED_EMAIL_DOMAINS.
BOOTSTRAP_ADMIN_EMAIL=admin@gimasys.com
BOOTSTRAP_ADMIN_NAME=Quản trị viên Gimasys
# Nguồn sự thật của mật khẩu admin. Để rỗng = không tạo/không đồng bộ.
# Đổi mật khẩu = đổi biến này rồi deploy lại (đổi trong UI sẽ bị ghi lại ở lần deploy sau).
BOOTSTRAP_ADMIN_PASSWORD=

# --- Cloud storage (bucket) ---
# local | gcs | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For local dev, an absolute base makes content_url usable from the frontend:
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
MAX_UPLOAD_MB=25

# When STORAGE_BACKEND=gcs (Google Cloud Storage).
# No keys here: auth uses Application Default Credentials.
#   Cloud Run  -> the service account attached to the service
#   local dev  -> gcloud auth application-default login
#                 (or GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json)
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_PREFIX=uploads
# Leave empty to use https://storage.googleapis.com/<bucket>; set for a CDN/custom domain.
GCS_PUBLIC_URL_BASE=
# GOOGLE_APPLICATION_CREDENTIALS=

# When STORAGE_BACKEND=s3 (S3-compatible / MinIO / GCS XML API):
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL_BASE=
