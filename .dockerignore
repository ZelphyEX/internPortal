# Secrets — never bake into the image
.env
.env.*

# Virtualenvs / caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS / CI / docs / tests / local storage — not needed at runtime
.git/
.gitignore
.gitattributes
.github/
docs/
tests/
storage/
uploads/
*.md

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
